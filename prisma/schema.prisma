// Prisma schema — SQLite (a local file database, no server or account needed)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("user") // "admin" | "user"
  phone        String   @default("")
  bio          String   @default("")
  skills       String   @default("[]") // JSON-encoded string array
  links        String   @default("{}") // JSON-encoded { github, linkedin, portfolio }
  createdAt    DateTime @default(now())

  experience       Experience[]
  teamMemberships  TeamMember[]
  createdHackathons Hackathon[] @relation("HackathonCreator")
  createdTeams      Team[]      @relation("TeamCreator")
}

model Experience {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String @default("")
  year        String @default("")
}

model Hackathon {
  id                 String   @id @default(cuid())
  title              String
  organizer          String   @default("")
  description        String   @default("")
  fields             String   @default("[]") // JSON-encoded string array
  location           String   @default("عن بعد")
  date               DateTime
  durationDays       Int      @default(2)
  prize              Int      @default(0)
  teamSizeMin        Int      @default(1)
  teamSizeMax        Int      @default(4)
  registrationStatus String   @default("مفتوح")
  targetAudience     String   @default("")
  coverImage         String   @default("")
  officialUrl        String
  createdById        String?
  createdBy          User?    @relation("HackathonCreator", fields: [createdById], references: [id])
  createdAt          DateTime @default(now())

  teams Team[]
}

model Team {
  id           String   @id @default(cuid())
  hackathonId  String
  hackathon    Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  name         String
  description  String   @default("")
  skillsNeeded String   @default("[]") // JSON-encoded string array
  maxMembers   Int      @default(4)
  createdById  String?
  createdBy    User?    @relation("TeamCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  members TeamMember[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

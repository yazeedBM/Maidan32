# Free hosted Postgres database from Neon (neon.tech) - no credit card required.
# After creating a free Neon project, copy its connection string here.
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require"

# Secret used to sign JWT auth tokens - use a long random string in production
JWT_SECRET=replace-this-with-a-long-random-string

# Shared key required to register as an Admin from the signup page (optional but recommended)
ADMIN_SIGNUP_KEY=choose-a-secret-invite-key
